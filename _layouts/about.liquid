---
layout: default
---
<script>
  // First-time visitors land in the cosmic dark theme; their own toggle (saved
  // to localStorage) always wins on later visits.
  (function () {
    try {
      var t = localStorage.getItem("theme");
      // al-folio pre-seeds "system"; treat both unset and "system" as "no
      // explicit choice yet" and default such visitors to the cosmic dark theme.
      if (!t || t === "system") {
        localStorage.setItem("theme", "dark");
        if (typeof setThemeSetting === "function") setThemeSetting("dark");
        else document.documentElement.setAttribute("data-theme", "dark");
      }
    } catch (e) {}
  })();
</script>
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% comment %} Plain <img> instead of figure.liquid: bypass imagemagick/WebP,
             which flattens the transparent PNG to a white background on production. {% endcomment %}
          <img
            src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}"
            class="{{ profile_image_class }}"
            alt="{{ page.profile.image }}"
            loading="eager"
          >
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
        {% if page.social %}
          <div class="profile-social contact-icons">{% social_links %}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix about-glass">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      <div class="about-glass">{% include news.liquid limit=true %}</div>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      <div class="about-glass">{% include selected_papers.liquid %}</div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>

  <!-- Corner black hole (homepage only). Inspired by ghostty-blackhole / @s13k_ (MIT). -->
  <script src="{{ '/assets/js/blackhole-corner.js' | relative_url }}"></script>

  <!-- Occasional shooting stars (homepage only, dark mode). -->
  <script src="{{ '/assets/js/meteors.js' | relative_url }}"></script>

  <!-- Twinkling glow stars at a few fixed spots (homepage only, dark mode). -->
  <div id="twinkle-layer" aria-hidden="true">
    <span class="twinkle" style="left: 97vw; top: 58.5vh; --tw-dur: 2.6s; --tw-delay: 0.8s;"></span>
    <span class="twinkle" style="left: 79.4vw; top: 55.8vh; --tw-dur: 3.2s; --tw-delay: 1.2s;"></span>
    <span class="twinkle" style="left: 77vw; top: 92vh; --tw-dur: 3.0s; --tw-delay: 0.6s;"></span>
    <span class="twinkle" style="left: 42.5vw; top: 6.5vh; --tw-dur: 1.6s; --tw-delay: 0.8s;"></span>
    <span class="twinkle" style="left: 9.7vw; top: 42.5vh; --tw-dur: 2.2s; --tw-delay: 1.2s;"></span>
    <span class="twinkle" style="left: 17vw; top: 25.3vh; --tw-dur: 2.8s; --tw-delay: 1.4s;"></span>
  </div>

  <!-- Pixel astronaut mascot (homepage only). By Njuk.Wedang / Godofnjuk. -->
  <img class="astronaut-mascot" src="{{ '/assets/img/astro_walkjump.gif' | relative_url }}" alt="" aria-hidden="true">

  <!-- Pixel spaceship mascot (homepage only), bottom-right — DISABLED for now.
       To re-enable: delete the {% raw %}{% comment %}/{% endcomment %}{% endraw %} wrapper below. -->
  {% comment %}
  <img class="spaceship-mascot" src="{{ '/assets/img/spaceship.gif' | relative_url }}" alt="" aria-hidden="true">
  {% endcomment %}
</div>
